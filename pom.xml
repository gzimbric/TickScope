<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cc.zimbri</groupId>
  <artifactId>tickscope</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>
  <name>TickScope</name>
  <description>Prometheus exporter for Paper and Folia. No runtime dependencies.</description>
  <url>https://github.com/gzimbric/TickScope</url>

  <licenses>
    <license>
      <name>GNU General Public License v3.0 or later</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>gzimbric</id>
      <name>Gabe Zimbric</name>
      <url>https://github.com/gzimbric</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/gzimbric/TickScope</url>
    <connection>scm:git:https://github.com/gzimbric/TickScope.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Pins archive entry timestamps so a given source tree always builds to the same
         bytes. This is what lets anyone rebuild a tag and check it against the published
         .sha256, and it lets the release workflow refuse a retry whose output differs.
         Bump it when cutting a release; leaving it stale only dates the entries. -->
    <project.build.outputTimestamp>2026-08-12T00:00:00Z</project.build.outputTimestamp>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <paper.version>26.2.build.111-stable</paper.version>
    <junit.version>5.14.2</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- provided: Paper supplies this at runtime. Nothing is shaded, so the jar
         stays in the tens of KB and there is no library resolution at load time. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>TickScope-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>plugin.yml</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>plugin.yml</exclude></excludes>
      </resource>
    </resources>
  </build>
</project>
